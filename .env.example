# Copia este archivo a .env en la raíz del repo.

# Orígenes permitidos por CORS
# Ejemplo: https://dominio.com,https://www.dominio.com
CORS_ORIGINS=

# Host de MongoDB. En Docker Compose el servicio se llama "mongodb"
MONGO_HOST=

# Credenciales de base de datos 
MONGO_USERNAME=
MONGO_PASSWORD=
# Nombre de la BD 
MONGO_DATABASE=kanban_db

# Cloudinary 
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firma de JWT 
JWT_SECRET=

# Claves de Stripe para suscripciones
STRIPE_SECRET_KEY= 
STRIPE_PRICE_PRO= 
STRIPE_PRICE_TEAM= 

# URLs de redirección tras pago en Stripe (ajusta a tu frontend)
STRIPE_SUCCESS_URL= 
STRIPE_CANCEL_URL= 

# Tras salir del Customer Portal de Stripe (perfil en tu app)
STRIPE_PORTAL_RETURN_URL=

# Secreto del webhook (Stripe CLI o Dashboard)
STRIPE_WEBHOOK_SECRET=