# Copia este archivo a env en la raiz del repo

# Origenes permitidos por cors
# Ejemplo: https://dominio.com,https://www.dominio.com
CORS_ORIGINS=

# Host de mongodb
MONGO_HOST=

# Credenciales de base de datos
MONGO_USERNAME=
MONGO_PASSWORD=
# Nombre de la bd
MONGO_DATABASE=kanban_db

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firma de jwt
JWT_SECRET=

# Claves de Stripe para suscripciones
STRIPE_SECRET_KEY= 
STRIPE_PRICE_PRO= 
STRIPE_PRICE_TEAM= 

# Urls de redireccion tras pago en stripe
STRIPE_SUCCESS_URL= 
STRIPE_CANCEL_URL= 

# Tras salir del customer portal de stripe
STRIPE_PORTAL_RETURN_URL=

# Secreto del webhook
STRIPE_WEBHOOK_SECRET=